# Original game data and dumps must NEVER land in this repo.
*.ios
*.win
*.gml
*_research/
gml_dump/

# The shipped asset pack: sprites, audio and the font are extracted from the
# game and committed — the asset posture allows it (all extracted audio and
# art may ship publicly). tools/extract-assets.sh regenerates the lot.
*.png
!assets/sprites/*.png
!assets/font/*.png

# Audio ships per the project's permission posture; raw extraction scratch
# does not.
!assets/audio/*.wav
!assets/audio/*.ogg
/tmp/
*.log

node_modules/
.DS_Store
