# Original game data and dumps must NEVER land in this repo.
*.ios
*.win
*.gml
*_research/
gml_dump/

# The shipped asset pack: sprites, audio and the font are extracted from the
# game and committed — the asset posture allows it (all extracted audio and
# art may ship publicly). tools/extract-assets.sh regenerates the lot.
*.png
!assets/sprites/*.png
!assets/font/*.png

# AUDIO SHIPS, EVERYWHERE IN THE REPO — standing project policy
# (2026-08-20): audio is fully permitted in these projects for as long as
# they are not paywalled and are donation-supported only. (No global
# audio block ever existed here; this records the policy.) Raw game data
# above does not move.
/tmp/
*.log

node_modules/
.DS_Store
